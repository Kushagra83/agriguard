PORT=8000
MONGO_URI=
MODEL_NAME=yolov8l.pt

# Intrusion Policy
CONFIDENCE_THRESHOLD=0.60
EXPECTED_CLASSES=cow,sheep,bird
COOLDOWN_SECONDS=5.0

# Hardware Targets (Update when ESP32 is connected, use 0 for laptop webcam testing)
CAMERA_STREAM_URL=http://<camera_ip>:8080/video
ESP32_ALARM_URL=http://127.0.0.1:8080/alarm_on